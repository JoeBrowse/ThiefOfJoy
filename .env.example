# Copy to .env.local for local development (never commit .env.local).
# In Vercel, set these under Project → Settings → Environment Variables.

# Supabase project URL: Supabase dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public (publishable) key: Supabase dashboard → Project Settings → API Keys.
# Safe to expose in the browser; Row Level Security protects the data.
# The legacy "anon" key also works (NEXT_PUBLIC_SUPABASE_ANON_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: your public site URL. On Vercel this is detected automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
