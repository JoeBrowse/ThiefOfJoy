/**
 * Generates a migration that syncs life_categories and assessment_questions
 * with src/lib/content/categories.ts.
 *
 *   npm run db:generate-seed            -> new timestamped migration
 *   npm run db:generate-seed -- <file>  -> write to a specific file
 *
 * Questions removed from the TS file are marked inactive (never deleted, so
 * historical answers keep their foreign keys).
 */
import { writeFileSync } from "node:fs";
import { join } from "node:path";
import { CATEGORIES } from "../src/lib/content/categories.ts";

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;

const lines: string[] = [
  "-- GENERATED by scripts/generate-seed.mts from src/lib/content/categories.ts. Do not edit by hand.",
  "",
];

lines.push("insert into public.life_categories (id, position, name, short_name) values");
lines.push(
  CATEGORIES.map((c, i) => `  (${q(c.id)}, ${i + 1}, ${q(c.name)}, ${q(c.shortName)})`).join(",\n") +
    "\non conflict (id) do update set position = excluded.position, name = excluded.name, short_name = excluded.short_name;",
);
lines.push("");

const questionRows: string[] = [];
for (const c of CATEGORIES) {
  c.questions.forEach((qu, i) => {
    questionRows.push(`  (${q(qu.id)}, ${q(c.id)}, ${i + 1}, ${q(qu.prompt)}, true)`);
  });
}
lines.push("insert into public.assessment_questions (id, category_id, position, prompt, is_active) values");
lines.push(
  questionRows.join(",\n") +
    "\non conflict (id) do update set category_id = excluded.category_id, position = excluded.position, prompt = excluded.prompt, is_active = true;",
);
lines.push("");

const allIds = CATEGORIES.flatMap((c) => c.questions.map((qu) => q(qu.id)));
lines.push(`update public.assessment_questions set is_active = false where id not in (${allIds.join(", ")});`);
lines.push("");

const target =
  process.argv[2] ??
  join(
    "supabase/migrations",
    `${new Date().toISOString().replace(/\D/g, "").slice(0, 14)}_sync_content.sql`,
  );
writeFileSync(target, lines.join("\n"));
console.log(`Wrote ${target} (${CATEGORIES.length} categories, ${questionRows.length} questions)`);
